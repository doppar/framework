@import "tailwindcss";
@source "../js";
@source "../../views";

:root {
    --bg: #fbfbf9;
    --card-bg: #ffffff;
    --card-border: #ececea;
    --text-color: #18181b;
    --muted: #6b7280;
    --line: #e7e5e4;
    --emerald: #10b981;
    --emerald-soft: #34d399;
    --orange: #fb923c;
    --violet: #807dfc;
    --yellow: #facc15;
    --panel-bg: #0a0a0a;
    color-scheme: light;
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    padding: 40px 20px;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: var(--bg);
    color: var(--text-color);
}

a {
    color: inherit;
}

code {
    background: #e5e7eb;
    padding: 2px 6px;
    border-radius: 4px;
    font-family: "JetBrains Mono", monospace;
}

.doppar-welcome {
    width: 100%;
    max-width: 980px;
}

.doppar-card {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 28px;
    overflow: hidden;
    box-shadow: 0 50px 100px -40px rgba(15, 23, 42, 0.18);
}

.doppar-panel {
    padding: 56px 52px;
}

.doppar-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--emerald);
    margin-bottom: 18px;
}

.doppar-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--emerald);
    box-shadow: 0 0 8px rgba(16, 185, 129, 0.7);
}

.doppar-heading {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 1.85rem;
    line-height: 1.2;
    margin: 0 0 30px;
}

.doppar-steps {
    margin-bottom: 34px;
}

.doppar-step {
    position: relative;
    padding-left: 30px;
    padding-bottom: 22px;
}

.doppar-step:last-child {
    padding-bottom: 0;
}

.doppar-step::before {
    content: "";
    position: absolute;
    left: 5px;
    top: 20px;
    bottom: -2px;
    width: 1px;
    background: var(--line);
}

.doppar-step:last-child::before {
    display: none;
}

.doppar-step-marker {
    position: absolute;
    left: 0;
    top: 2px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 1.5px solid var(--emerald-soft);
    background: #fff;
}

.doppar-step-marker::after {
    content: "";
    position: absolute;
    inset: 2.5px;
    border-radius: 50%;
    background: var(--emerald-soft);
}

.doppar-step-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #9ca3af;
    margin-bottom: 4px;
}

.doppar-step a {
    font-size: 14.5px;
    font-weight: 600;
    color: var(--text-color);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
}

.doppar-step a:hover {
    color: var(--emerald);
}

.doppar-arrow {
    font-size: 12px;
    color: var(--orange);
}

.doppar-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 26px;
    border-radius: 999px;
    background: var(--yellow);
    color: #171717;
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.01em;
    box-shadow: 0 14px 30px -12px rgba(250, 204, 21, 0.65);
    transition: transform .15s ease, box-shadow .15s ease;
}

.doppar-cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 18px 34px -12px rgba(250, 204, 21, 0.8);
}

.doppar-meta {
    margin-top: 30px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    color: #9ca3af;
}

.doppar-meta img {
    height: 14px;
    width: auto;
    margin-right: 6px;
}

.doppar-meta a {
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
}

.doppar-meta a:hover {
    color: var(--orange);
    border-color: var(--orange);
}

.doppar-art {
    position: relative;
    background: var(--panel-bg);
    min-height: 460px;
}

.doppar-art svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
}

@media (max-width: 860px) {
    .doppar-card {
        grid-template-columns: 1fr;
    }

    .doppar-panel {
        padding: 40px 28px;
        order: 2;
    }

    .doppar-art {
        min-height: 200px;
        order: 1;
    }
}
